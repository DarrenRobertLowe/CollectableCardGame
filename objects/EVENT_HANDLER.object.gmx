          <argument>
            <kind>1</kind>
            <string>/// QUEUE AND RUN EVENTS

events = ds_list_create();  // this is a list of maps where key=Object, value=event_user(number)
eventOwner = noone;         // the current key object

</string>
          </argument>
        </arguments>
      </action>
