        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// EFFECT TO PERFORM
var newCard                 = create_card(cc_BlackRat, owner);
newCard.freeCast            = true;
global.allowSacrifice       = true;
global.selectingSummonSlot  = true;
global.summoning            = true;
newCard.position            = "hand";
global.currentCard          = newCard;
waitTime                    = (room_speed * 0.25);
global.allowCancelCasting   = false; // lock the user into summoning

ds_list_add(global.NEXT_PHASE_BLOCKERS, newCard);
show_EventPopup(id, noone, "Activating!");
</string>
          </argument>
        </arguments>
      </action>
    </event>
